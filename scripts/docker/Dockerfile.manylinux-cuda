# Build environment for compliant pycolmap manylinux_2_34_x86_64 wheels
# with CUDA 13 support.
#
# Why this base:
#   - Rocky Linux 9 has glibc 2.34, which is exactly the floor for
#     manylinux_2_34_x86_64. A wheel built here can be loaded on any image
#     with glibc >= 2.34 (RHEL/Rocky/Alma 9, Ubuntu 22.04+, Debian 12+, ...).
#   - nvidia/cuda:<ver>-devel-rockylinux9 ships the full CUDA toolkit
#     (nvcc, libcudart, libcublas, ...) which we need at build time.
#
# Anything bundled into the wheel by `auditwheel repair` MUST come from this
# image (or be on $LD_LIBRARY_PATH at repair time). Anything excluded from
# the wheel must instead be present on the consumer image — currently that's
# only the CUDA runtime libs.
FROM nvidia/cuda:13.0.0-devel-rockylinux9

ENV LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# CRB ("CodeReady Builder", formerly PowerTools) hosts -devel packages for
# headers like qt5-qtbase-devel, etc. EPEL adds CGAL, flann, freeimage,
# gflags, suitesparse, etc.
RUN dnf install -y dnf-plugins-core epel-release \
    && dnf config-manager --set-enabled crb \
    && dnf clean all

# Build toolchain.
RUN dnf install -y \
        gcc gcc-c++ make ninja-build cmake git patch \
        zlib-devel \
        patchelf \
    && dnf clean all

# COLMAP system dependencies. EPEL 9 + CRB cover most of what COLMAP needs.
# Notable exceptions built from source in later layers:
#   - glog (EPEL ships 0.3.5 without glog-config.cmake; we need >= 0.6)
#   - ceres-solver (not packaged for EPEL 9)
#
# `--allowerasing` lets `libcurl-devel` replace the preinstalled
# `libcurl-minimal` (the two conflict on `libcurl.so`).
RUN dnf install -y --allowerasing \
        boost-devel \
        eigen3-devel \
        suitesparse-devel \
        flann-devel \
        freeimage-devel \
        OpenImageIO-devel \
        gflags-devel \
        lz4-devel \
        sqlite-devel \
        CGAL-devel gmp-devel mpfr-devel \
        libcurl-devel openssl-devel \
        mesa-libGL-devel mesa-libGLU-devel libglvnd-devel \
        glew-devel \
        metis-devel \
        qt5-qtbase-devel qt5-qtbase-gui \
    && dnf clean all

# Build glog from source. EPEL 9's glog-devel is 0.3.5 and ships no
# CMake config file, which forces find_package(Glog) into Module mode and
# triggers a duplicate-target collision when Ceres's CeresConfig.cmake
# transitively re-imports glog::glog. glog >= 0.6 installs glog-config.cmake,
# which is idempotent. Building glog *before* Ceres also makes Ceres's
# generated CeresConfig.cmake use modern Config-mode discovery for glog
# instead of the legacy uppercase-variable logic.
ARG GLOG_VERSION=0.6.0
RUN cd /tmp \
    && git clone --depth 1 --branch v${GLOG_VERSION} https://github.com/google/glog.git \
    && cmake -S glog -B glog-build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DWITH_GTEST=OFF \
    && ninja -C glog-build install \
    && rm -rf /tmp/glog /tmp/glog-build

# Build Ceres Solver from source (not in EPEL 9). Pinned to a known-good
# release; bump alongside COLMAP when needed.
ARG CERES_VERSION=2.2.0
RUN cd /tmp \
    && git clone --depth 1 --branch ${CERES_VERSION} https://github.com/ceres-solver/ceres-solver.git \
    && cmake -S ceres-solver -B ceres-build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DUSE_CUDA=OFF \
    && ninja -C ceres-build install \
    && rm -rf /tmp/ceres-solver /tmp/ceres-build

# Python 3.12 from AppStream + the wheel-building stack.
RUN dnf install -y python3.12 python3.12-devel python3.12-pip \
    && alternatives --install /usr/bin/python python /usr/bin/python3.12 100 \
    && python3.12 -m pip install --no-cache-dir --upgrade \
        pip \
        "auditwheel>=6" \
        "patchelf>=0.17" \
        build \
        wheel \
    && dnf clean all

# Intel oneAPI MKL — what BLA_VENDOR=Intel10_64lp links against in COLMAP.
# We add Intel's RPM repo, install only the runtime + dev components needed
# for linking, and leave the rest out to keep the image smaller.
RUN tee /etc/yum.repos.d/oneAPI.repo >/dev/null <<'EOF'
[oneAPI]
name=Intel(R) oneAPI repository
baseurl=https://yum.repos.intel.com/oneapi
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
EOF

# intel-oneapi-mkl-devel ships MKL itself; intel-oneapi-openmp ships
# libiomp5.so, which CMake's FindBLAS link-tests for when
# BLA_VENDOR=Intel10_64lp (threaded MKL). Without iomp5 the link test
# fails and find_package(BLAS) reports BLAS_FOUND=FALSE, even though
# the MKL libs are present.
RUN rpm --import https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    && dnf install -y intel-oneapi-mkl-devel intel-oneapi-openmp \
    && dnf clean all

# Intel oneAPI 2024+ ships MKL libs under ${MKLROOT}/lib/, but CMake 3.26's
# bundled FindBLAS module (and any consumer using find_package(BLAS) with
# BLA_VENDOR=Intel10_64lp) still searches ${MKLROOT}/lib/intel64/. Create a
# self-loop symlink so the legacy path resolves to the modern layout.
# Without this, transitive find_package(BLAS) chains (e.g. inside Ceres's
# CeresConfig.cmake → find_dependency(SuiteSparse) → find_package(BLAS))
# fail, even though MKL is installed.
RUN ln -sfn . /opt/intel/oneapi/mkl/latest/lib/intel64

# Make MKL + Intel OpenMP discoverable to CMake's find_package(BLAS) (which
# link-tests libmkl_intel_thread + libiomp5 when BLA_VENDOR=Intel10_64lp)
# and to the dynamic loader at auditwheel-repair time. Note that libiomp5
# lives under .../compiler/latest/lib, not under .../mkl/latest/lib — they
# are separate Intel oneAPI components.
ENV MKLROOT=/opt/intel/oneapi/mkl/latest
ENV INTEL_COMPILER_RUNTIME=/opt/intel/oneapi/compiler/latest/lib
ENV LD_LIBRARY_PATH=${MKLROOT}/lib:${INTEL_COMPILER_RUNTIME}:/usr/local/lib64:/usr/local/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}
ENV LIBRARY_PATH=${MKLROOT}/lib:${INTEL_COMPILER_RUNTIME}
ENV CMAKE_PREFIX_PATH=${MKLROOT}

WORKDIR /work
